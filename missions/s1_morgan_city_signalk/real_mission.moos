ServerHost   = localhost
ServerPort   = 9000
Community    = alpha
MOOSTimeWarp = 1

//Morgan City
LatOrigin  = 29.71970895316288
LongOrigin = -91.14705165281887

//------------------------------------------
// Antler configuration  block
ProcessConfig = ANTLER
{
  MSBetweenLaunches = 200

  Run = MOOSDB        @ NewConsole = false
  Run = pLogger       @ NewConsole = false
  //Run = uSimMarineV22 @ NewConsole = false
  //Run = pMarinePIDV22 @ NewConsole = false# Find the header

  Run = planchaPID @ NewConsole = false
  Run = iDivisorNMEA	@ NewConsole = false
  Run = pHelmIvP      @ NewConsole = false
  Run = pMarineViewer	@ NewConsole = false
  Run = uProcessWatch	@ NewConsole = false
  Run = pNodeReporter	@ NewConsole = false
  Run = pRealm	      @ NewConsole = false
  Run = iCAN	      @ NewConsole = false
  Run = iCANRec	      @ NewConsole = false
  //Run = iNMEA	      @ NewConsole = false
  //Run = iSignalK	      @ NewConsole = false
  Run = iWebSocket	      @ NewConsole = false
  Run = pXYpublisher      @ NewConsole = false
  Run = pContactSpawn	      @ NewConsole = false
  Run = pContactMgrV20 @ NewConsole = false
  Run = iRadarTargets @ NewConsole = false
  Run = pMultisensorfusion  @ NewConsole = false
  Run = uXMS            @ NewConsole = true
 // Run = pVisionDetector_ref @ NewConsole = false
  //Run = pMultivisiondetector @ NewConsole = true
  Run = pMultivisiondetector_ref @ NewConsole = true

}


//---------------------------------------------------
// pMultivisiondetector_ref Configuration
//---------------------------------------------------
ProcessConfig = pMultivisiondetector_ref
{
  AppTick   = 20
  CommsTick = 20
  
  camera_height = 2.13
  object_height = 2.5           # ✅ NOT average_boat_height
  horizontal_fov = 87
  vertical_fov = 46
  distance_cal_factor = 0.5     # ✅ NOT distance_calibration_factor
  confidence = 0.25             # ✅ NOT confidence_threshold
  nms_threshold = 0.45
  target_class = 8
}

ProcessConfig = uXMS
{
  AppTick   = 4
  CommsTick = 4
  
  var = RADAR_TARGETS, AIS_REPORT, VISION_REPORT
  var = NODE_REPORT, FUSION_DEBUG
  var = NAV_X, NAV_Y, NAV_HEADING
  
  display_virgins = true
  display_source = true
  display_time = true
  display_community = false
}
# Find the header

//--------------------------------------------------------------
// pVisionDetector - Camera-Based Detection
//--------------------------------------------------------------
ProcessConfig = pVisionDetector
{
  AppTick   = 20
  CommsTick = 20
  
  rtsp_url = rtsp://douglas:Brazil2025!~@192.168.143.14:554/Streaming/Channels/101
  yolo_model_path = /home/douglas/Documents/yolo/yolo11n_openvino_model/yolo11n.xml
  
  confidence_threshold = 0.25
  nms_threshold = 0.45
  target_class = 8  // boat
  
  camera_height = 2.13
  average_boat_height = 2.5
  horizontal_fov = 87
  vertical_fov = 46
  distance_calibration_factor = 0.5
  
  exclusion_zone = 0.3,0.8,0.65,1.0
}

//---------------------------------------------------
// pMultivisiondetector Configuration
//---------------------------------------------------
ProcessConfig = pMultivisiondetector
{
 AppTick   = 20
 CommsTick = 20
 
 # FIXED: rtsp_url (not rtsp!)
 rtsp_url = "rtsp://douglas:Brazil2025!~@192.168.1.65:554/Streaming/Channels/101"
 
 yolo_model_path = /home/douglas/Documents/yolo/yolo11n_openvino_model/yolo11n.xml

 confidence_threshold = 0.25
 nms_threshold = 0.45
 
 camera_height_m = 2.13
 known_object_height_m = 2.5
 horizontal_fov_deg = 87
 vertical_fov_deg = 46
 distance_cal_factor = 0.5

 use_exclusion_zone = true
 
 show_video = false
 publish_rate_hz = 5
 publish_node_report = false
 publish_debug = true
 
 min_range_m = 5.0
 max_range_m = 500.0
}


ProcessConfig = pMultisensorfusion
{
  AppTick   = 10
  CommsTick = 10
  
  //=================================================
  // Geodesy (required for AIS lat/lon conversion)
  //=================================================
  lat_origin = 42.3601
  lon_origin = -71.0589
  
  //=================================================
  // Radar Parameters
  //=================================================
  radar_noise_x = 5.0
  radar_noise_y = 5.0
  
  //=================================================
  // AIS Parameters
  //=================================================
  ais_pos_noise = 10.0
  ais_vel_noise = 0.5
  
  //=================================================
  // Vision Parameters (CRITICAL: bearing-only)
  //=================================================
  vision_bearing_noise_deg = 2.0
  vision_can_initiate_tracks = false
  vision_only_max_scans = 10
  
  // Camera calibration
  camera_fx = 1000.0
  camera_cx = 640.0
  camera_yaw_offset_deg = 0.0
  
  //=================================================
  // Process Noise
  //=================================================
  process_noise_cv = 0.5
  
  //=================================================
  // Data Association
  //=================================================
  gate_threshold = 9.0
  bearing_gate_threshold = 10.0
  
  //=================================================
  // Track Management
  //=================================================
  confirm_min_hits = 3
  confirm_min_scans = 5
  delete_max_misses = 5
  
  //=================================================
  // Publishing
  //=================================================
  publish_rate_hz = 2.0
  publish_debug = true
  
  vision_only_max_scans = 10        
  confirm_min_scans = 5             
}




// iRadarTargets Config Block

ProcessConfig = iRadarTargets
{
  AppTick   = 10
  CommsTick = 10

  // UDP Configuration
  udp_port = 8091       // Port to receive NMEA $RATTM sentences
  udp_host = 127.0.0.1  // Host interface (localhost by default)
}

// pContactSpawn Config Block

ProcessConfig = pContactSpawn
{
  AppTick 	= 1
  CommsTick = 1 
}

//--------------------------------------------------------
// pContactMgrV20 Config Block

ProcessConfig = pContactMgrV20
{
  AppTick   = 2
  CommsTick = 2

  decay = 5,10

	app_logging = true
	
  alert_verbose = true

	contact_local_coords = force_lat_lon
	
  contact_max_age   = 5
  display_radii     = true
	display_radii_id  = avd
  alert_range_color = gray70
  cpa_range_color   = gray30

	alert = id=avdcol_, var=CONTACT_INFO, val="name=$[VNAME] # contact=$[VNAME]"
  alert = id=avdcol_, alert_range=1000, cpa_range=500
	
	//match_region = pts = {60,-40 : 60,-160 : 150,-160 : 180,-100 : 150,-40}
	//match_type = kayak, uuv

  disable_var = XYZ_DISABLE_TARGET
  enable_var  = XYZ_REENABLE_TARGET
	
	post_closest_range   = true
  hold_alerts_for_helm = true
}



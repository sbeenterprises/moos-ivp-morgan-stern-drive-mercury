
//-------------------------------------------------
// NAME: D. Lima
// FILE: real_usv725.moos
//
// Real-boat mission for USV-725: Mercury Diesel 2.0L stern drive, Glendinning helm (profiles/mercury_sterndrive.prf)
// Run on that boat:  pAntler real_usv725.moos
// Everything boat-specific (CAN IDs, throttle curve, rudder limits,
// autopilot tuning) is in the profile; this file only selects it and
// sets the boat's identity. Keep it in step with real_usv722.moos.
//-------------------------------------------------

ServerHost   = localhost
ServerPort   = 9000
Community    = alpha
MOOSTimeWarp = 1

// Lumut (where USV-725 operates; Morgan City is 29.71970895316288, -91.14705165281887)
LatOrigin  = 4.2245
LongOrigin = 100.5868

//------------------------------------------
// Antler configuration  block
ProcessConfig = ANTLER
{
  MSBetweenLaunches = 200

  Run = MOOSDB        @ NewConsole = false
  Run = pLogger       @ NewConsole = false
  //Run = uSimMarineV22 @ NewConsole = false
  //Run = pMarinePIDV22 @ NewConsole = false
  Run = planchaPID @ NewConsole = false
  Run = iDivisorNMEA	@ NewConsole = false
  Run = pHelmIvP      @ NewConsole = false
  //Run = pMarineViewer	@ NewConsole = false
  Run = uProcessWatch	@ NewConsole = false
  Run = pNodeReporter	@ NewConsole = false
  Run = pRealm	      @ NewConsole = false
  Run = iCAN	      @ NewConsole = false
  Run = iCANRec	      @ NewConsole = false
  //Run = iNMEA	      @ NewConsole = false
  //Run = iSignalK	      @ NewConsole = false
  Run = iWebSocket	      @ NewConsole = false
  Run = pCorridor     @ NewConsole = false
  Run = pTurnLimit    @ NewConsole = false
  Run = pColavScale   @ NewConsole = false
  Run = pNavGuard     @ NewConsole = false
  Run = pXYpublisher      @ NewConsole = false
  Run = pContactSpawn	      @ NewConsole = false
  Run = pContactMgrV20 @ NewConsole = false
  Run = iRadarTargets @ NewConsole = false
  Run = grafana_bridge  @ NewConsole = false
}

// iRadarTargets Config Block

ProcessConfig = iRadarTargets
{
  AppTick   = 10
  CommsTick = 10

  // UDP Configuration
  udp_port = 8091       // Port to receive NMEA $RATTM sentences
  udp_host = 127.0.0.1  // Host interface (localhost by default)
}

// pContactSpawn Config Block

ProcessConfig = pContactSpawn
{
  AppTick 	= 1
  CommsTick = 1 
}

//--------------------------------------------------------
// pContactMgrV20 Config Block

ProcessConfig = pContactMgrV20
{
  AppTick   = 2
  CommsTick = 2

  decay = 5,10

	app_logging = true
	
  alert_verbose = true

	contact_local_coords = force_lat_lon
	
  contact_max_age   = 5
  display_radii     = true
	display_radii_id  = avd
  alert_range_color = gray70
  cpa_range_color   = gray30

	alert = id=avdcol_, var=CONTACT_INFO, val="name=$[VNAME] # contact=$[VNAME]"
  alert = id=avdcol_, alert_range=1000, cpa_range=500
	
	//match_region = pts = {60,-40 : 60,-160 : 150,-160 : 180,-100 : 150,-40}
	//match_type = kayak, uuv

  disable_var = XYZ_DISABLE_TARGET
  enable_var  = XYZ_REENABLE_TARGET
	
	post_closest_range   = true
  hold_alerts_for_helm = true
}


// iCANRec config block

ProcessConfig = iCANRec
{
   AppTick   = 20
   CommsTick = 20
}

// pXYpublisher config block

ProcessConfig = pXYpublisher
{
   AppTick   = 4
   CommsTick = 4
}
//------------------------------------------------


// iCAN config block

ProcessConfig = iCAN
{
   AppTick   = 50
   CommsTick = 50

   // Manual control, one lever: DESIRED_THRUST -100..+100 sets gear and
   // throttle together (+ ahead, - astern, 0 neutral); DESIRED_GEAR is
   // ignored. The profile's shift interlock still passes through neutral.
   // Set to "command" for separate gear buttons (A/N/R) + throttle.
   manual_gear = thrust_sign

   // Lost link in autonomy too: rudder/throttle to the profile's lost_link_*
   // values (0 = neutral) while the link is down (iWebSocket ends the mission).
   lost_link_autonomy = stop

   // The boat's CAN IDs, scaling, limits, lost-link values and autopilot
   // tuning live in this profile (planchaPID reads the same line).
   profile_file = ../../profiles/mercury_sterndrive.prf
}
//------------------------------------------------

//------------------------------------------------
// iDivisorNMEA config block

ProcessConfig = iDivisorNMEA
{
   AppTick   = 20
   CommsTick = 20

   // This boat's own AIS MMSI, so its transponder echo is not taken as a
   // contact. Unset = code default 710400014. Set it for this boat:
   // ownship_mmsi = <MMSI>
}
//------------------------------------------------


//-------------------------------------------
// planchaPID bloco de config

ProcessConfig = planchaPID
{
   AppTick   = 20
   CommsTick = 20

   // Heading gains, rudder and thrust limits and the speed -> thrust map
   // are per boat: auto_* keys in the boat profile. planchaPID uses the
   // profile_file of the iCAN block below (or its own profile_file line).
}


//------------------------------------------------
// iWebSocket config block

ProcessConfig = iWebSocket
{
   AppTick   = 20
   CommsTick = 20

   // No message or ping reply from SS UI for this long = link lost.
   // In manual control iCAN then sets rudder 0 and throttle 0.
   link_timeout = 3
   // The same, for autonomy (used with lost_link_autonomy = stop).
   autonomy_link_timeout = 5

   // Lost link while autonomy drives (mission, station-keep, follow):
   // stop = end it as the UI's Stop does, so the boat stays stopped when
   // the link returns (keep in step with lost_link_autonomy in iCAN).
   // continue = carry on without the UI.
   lost_link_autonomy = stop

   // Starts (mission, RTB, station-keep, follow) are refused while pNavGuard
   // reports a navigation fault; true = also while it is not reporting.
   nav_guard_required = true

   // Who may command the boat. off = anyone who reaches port 8000 (as
   // before). signalk = iWebSocket asks the Signal K server (signalk_http,
   // host:port, plain HTTP) who each UI user is: read-only and anonymous
   // users still see everything, but their commands are refused and they do
   // not keep the link up. Check Signal K security on the boat before
   // turning it on: if Signal K cannot be reached, nobody can command.
   command_auth = off
   signalk_http = 127.0.0.1:3000

   // Exclusive control (needs command_auth = signalk): one operator session
   // at a time holds control; only it may command, and only its link keeps
   // UI_LINK_OK up. Operators take / release / request control from the UI,
   // a supervisor may force a takeover; any operator may press ALL STOP.
   // Roles come from the Signal K admin page (SwiftShips C2 plugin settings,
   // "Boat control roles"); the plugin writes them to roles_file. See docs/CONTROL.md.
   exclusive_control = false
   roles_file = /var/lib/swiftships-c2/roles.json
   // An unanswered request for control hands it over after this many seconds
   control_request_timeout = 15

   // Operating region: the polygon drawn in the UI is the HALT line; the
   // boat works inside it shrunk by this margin (BHV_OpRegionV26 breaches,
   // i.e. stops, on or just inside the drawn line).
   region_margin = 30
   // Halt this far before the drawn line, so the boat coasts to rest by it
   // (neutral, no braking). [P] set from the coasting distance at speed.
   region_halt_lead = 15
   // Speed to steer back into the working area (helm units: knots on the
   // boat, m/s in the sim); slow enough for a tight turn, enough to steer.
   region_recover_speed = 4
}

//------------------------------------------------
// pCorridor config block
//
// Route corridor monitor: cross-track error against the corridor the UI
// sends (CORRIDOR=...), zone in CORRIDOR_STATUS for the corridor_* behaviours
// in alpha.bhv. Thresholds, with half = width/2:
//   in <= slow_frac*half < slow <= half < recovering <= stop_factor*half < stop

ProcessConfig = pCorridor
{
  AppTick   = 4
  CommsTick = 4

  slow_frac    = 0.5   // "slow" beyond this share of the half width
  stop_factor  = 2.0   // "stop" beyond this many half widths
  hysteresis   = 2     // metres the xte must clear a boundary by to return
  recover_lead = 20    // metres ahead along the centreline to steer back to

  // While a corridor is on, waypt_survey follows the route tightly so it
  // neither skips short legs nor cuts corners; route_* restores alpha.bhv's
  // waypt_survey values when the corridor goes off (keep them in step).
  turn_slow_dist          = 60   // slow (CORRIDOR_TURN) this close to a sharp corner
  turn_min_angle          = 60   // degrees of heading change that count as sharp

  // No corridor speeds measured for this boat yet: the alpha.bhv speeds
  // apply (slow_speed / turn_speed / recover_speed unset). Steer back
  // rather than stop far outside, so the boat keeps steerage.
  turn_allowance          = 0
  stop_action             = recover

  tighten_following       = true
  corridor_capture_radius = 15
  corridor_slip_radius    = 30
  corridor_lead           = 60
  route_capture_radius    = 60
  route_slip_radius       = 90
  route_lead              = 400
}

//------------------------------------------------
// iNMEA config block

ProcessConfig = iNMEA
{
   AppTick   = 4
   CommsTick = 4
}

//------------------------------------------------
// iSignalK config block

ProcessConfig = iSignalK
{
   AppTick   = 4
   CommsTick = 4
}

//------------------------------------------
// pLogger config block

ProcessConfig = pLogger
{
  AppTick   = 8
  CommsTick = 8

  AsyncLog = true

  // For variables that are published in a bundle on their 
  // first post, explicitly declare their logging request
  Log = IVPHELM_LIFE_EVENT @ 0 NOSYNC
  Log = REPORT @ 0 NOSYNC
  Log = BHV_SETTINGS @ 0 NOSYNC
  Log = SUMMARY @ 0 NOSYNC

  LogAuxSrc = true
  WildCardLogging = true
  WildCardOmitPattern = *_STATUS
  // ...but keep pCorridor's zone: the omit above would drop it.
  Log = CORRIDOR_STATUS @ 0 NOSYNC
  WildCardOmitPattern = DB_VARSUMMARY
  WildCardOmitPattern = DB_RWSUMMARY
  WildCardExclusionLog = true
}

//------------------------------------------
// uProcessWatch config block

ProcessConfig = uProcessWatch
{
  AppTick   = 4
  CommsTick = 4

  watch_all = true
	nowatch   = uPokeDB*
	nowatch   = uQueryDB*
	nowatch   = uXMS*
	nowatch   = uMAC*
}


//------------------------------------------------
// pTurnLimit config block
//
// Holds the boat to turn_speed near sharp route corners (with or without a
// corridor) and while it turns hard (desired heading far off its heading:
// region turn-away, collision avoidance, follow). At speed the rudder is
// limited, so turns are wide; this keeps them tight. Only slows the boat.

ProcessConfig = pTurnLimit
{
  AppTick   = 4
  CommsTick = 4

  turn_speed      = 5    // knots
  heading_trigger = 45   // deg off the desired heading -> limit
  heading_release = 15   // ... released below this
  corner_dist     = 100  // m to a route corner turning by corner_angle+
  corner_angle    = 60   // (route capture radius is 60 m without a corridor)
  hold_secs       = 3
}

//------------------------------------------------
// pColavScale config block
//
// Collision-avoidance distances from closing speed, per contact: start
// avoiding outer_secs before a possible meeting, full priority inner_secs
// before. The UI's Calibration distances (COLAV_DIST) are the minimums;
// outer_max is also pContactMgrV20's alert range. [P] until water-tested.

ProcessConfig = pColavScale
{
  AppTick   = 4
  CommsTick = 4

  nav_speed_units     = knots
  contact_speed_units = mps    // NODE_REPORT SPD (radar sends knots: earlier, never later)
  outer_secs = 60
  inner_secs = 30
  outer_min  = 150
  inner_min  = 75
  outer_max  = 1400
  inner_max  = 700
  cpa_range  = 1500    // keep >= avdcol_ completed_dist in alpha.bhv
}

//------------------------------------------------
// pNavGuard config block
//
// Navigation integrity: compares heading, speed and course with what the
// GPS positions show, and watches for frozen / stale / jumping data. Warns
// the operator (NAV_STATUS in the UI) and, in a fault while the helm
// drives, stops the mission (NAV_GUARD_STOP -> iWebSocket; planchaPID
// holds neutral as a backup). Manual control is never affected. Check a
// log offline with: navguard_replay <file>.alog. [P] until water-tested.

ProcessConfig = pNavGuard
{
  AppTick   = 4
  CommsTick = 4

  nav_speed_units = knots
  nmea_var        = MSG_UDP  // raw NMEA from iDivisorNMEA (RMC status V = no fix)
  min_speed       = 3      // knots, heading / speed / follow checks above it
  speed_tol       = 2      // knots, NAV_SPEED vs GPS positions
  jump_speed      = 60     // knots, faster step between fixes = jump
  stop_on_fault   = true
  heading_tol     = 45     // deg, NAV_HEADING vs GPS track on straight runs
  heading_secs    = 10     // ... for this long = fault
  speed_secs      = 8
  freeze_secs     = 5      // speed / course not changing while the GPS shows it should
  heading_freeze_secs = 10
  stale_secs      = 3      // no new GPS position
  jump_min_dist   = 15     // m
  gps_flag_secs   = 2
  follow_tol      = 60     // deg, autonomy: track off the commanded course ...
  follow_secs     = 20     // ... for this long (not while turning toward it)
  clear_secs      = 10     // a fault clears after this long with all checks clean
}


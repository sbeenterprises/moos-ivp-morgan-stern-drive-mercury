
//-------------------------------------------------
// NAME: D. Lima
// FILE: alpha.moos
//-------------------------------------------------

ServerHost   = localhost
ServerPort   = 9000
Community    = alpha
MOOSTimeWarp = 1

//Morgan City
LatOrigin  = 29.71970895316288
LongOrigin = -91.14705165281887

//------------------------------------------
// Antler configuration  block
ProcessConfig = ANTLER
{
  MSBetweenLaunches = 200

  Run = MOOSDB        @ NewConsole = false
  //Run = pLogger       @ NewConsole = false
  Run = uSimMarineV22 @ NewConsole = false
  //Run = pMarinePIDV22 @ NewConsole = false
  Run = planchaPID @ NewConsole = false
  //Run = iDivisorNMEA	@ NewConsole = false
  Run = pHelmIvP      @ NewConsole = false
  Run = pMarineViewer	@ NewConsole = false
  Run = uProcessWatch	@ NewConsole = false
  Run = pNodeReporter	@ NewConsole = false
  Run = pRealm	      @ NewConsole = false
  //Run = iRaspberryServer	      @ NewConsole = false
  Run = iNMEA	      @ NewConsole = false
  Run = iWebSocket	      @ NewConsole = false
  Run = iCANRec	      @ NewConsole = false
  Run = pContactSpawn	      @ NewConsole = false
  Run = pTrafficSim   @ NewConsole = false
  Run = pContactMgrV20 @ NewConsole = false
  Run = pColavEval    @ NewConsole = false
  // Off: it needs a NODE_REPORT for ownship as well as for the contacts, and
  // in this community pNodeReporter publishes the boat's own report as
  // NODE_REPORT_LOCAL. Pointing it at NODE_REPORT instead would make
  // pContactMgrV20 treat the boat as its own contact. See the config block
  // below - pColavEval already folds UCD_REPORT in if it ever does run.
  //Run = uFldCollisionDetect @ NewConsole = false
  Run = iMOOSGateway  @ NewConsole = false
  Run = iRadarTargets @ NewConsole = false
}

// iRadarTargets Config Block

ProcessConfig = iRadarTargets
{
  AppTick   = 10
  CommsTick = 10

  // UDP Configuration
  udp_port = 8091       // Port to receive NMEA $RATTM sentences
  udp_host = 127.0.0.1  // Host interface (localhost by default)
}


// pContactSpawn Config Block

ProcessConfig = pContactSpawn
{
  AppTick 	= 1
  CommsTick = 1 
}

// pTrafficSim Config Block

ProcessConfig = pTrafficSim
{
  AppTick   = 4
  CommsTick = 4

  enable_simulation = true

  // origin defaults to LatOrigin/LongOrigin above; stated here for clarity
  origin_lat = 29.71970895316288
  origin_lon = -91.14705165281887

  aivdm_host = 127.0.0.1     // Signal K NMEA0183 UDP listener (settings.json)
  aivdm_port = 10112
  mmsi_base  = 366999000     // clearly fake MMSI block

  // Targets placed at runtime from the UI (right-click > Put Target) draw from
  // their own MMSI block, so AIS3669999xx is unambiguously a test target and
  // can never collide with an MMSI handed to a scenario contact below.
  spawn_mmsi_base      = 366999900
  max_runtime_contacts = 8
  spawn_max_range      = 10000   // metres from the USV; further just refuses
  expunge_var          = XYZ_EXPUNGE_TARGET

  // A target told to aim at the USV keeps correcting its intercept until it is
  // this close, then locks course for the rest of the run. Well outside the
  // behaviour's 300 m envelope, so the helm only ever sees a steady contact -
  // but close enough that the encounter actually happens instead of the target
  // sailing past a few hundred metres away because the boat accelerated after
  // the course was first solved.
  aim_lock_range       = 400

  position_interval = 1      // AIS msg 1 per contact, seconds
  static_interval   = 30     // AIS msg 5 per contact, seconds

  // pMarineViewer sizes each contact icon from the NODE_REPORT LENGTH field.
  // One value for every contact keeps them all the same size on the viewer;
  // set 0 to fall back to each contact's real length. The AIS message 5
  // dimensions sent to Signal K always use the real length/beam either way.
  report_length = 60

  // (a) scripted contacts - deterministic, repeatable
  // Three targets laid out on uSimMarine's outbound track (start_pos
  // x=-6289, y=400, heading 38.7): one dead ahead, one 300 m to starboard and
  // one 300 m to port, all 2500 m out along the track to the northeast.
  //
  //                  PORT  *          * ALPHA          * STBD
  //                   (-6.8 deg)      (dead ahead)      (+6.8 deg)
  //                          \           |           /
  //                           \          |          /   all three closing
  //                            \         |         /    on hdg 218.7
  //                                    [USV] hdg 38.7
  //
  // All three run the reciprocal heading (218.7) at 2.572 m/s = 5.0 knots -
  // spd is in m/s, pTrafficSim converts to knots for the AIS SOG field. Because
  // the tracks are parallel and opposing, each target holds its side of the
  // track all the way in: ALPHA stays a head-on collision course, BRAVO passes
  // 300 m down the starboard side and CHARLIE 300 m down the port side.
  // For a crossing encounter instead, give a flanker hdg 308.7 (from starboard,
  // USV gives way) or hdg 128.7 (from port, USV stands on).
  contact = name=TARGET_ALPHA,   type=cargo, x=-4725.9, y=2351.1, hdg=218.7, spd=2.572, length=25, beam=9
  contact = name=TARGET_BRAVO,   type=cargo, x=-4491.8, y=2163.5, hdg=218.7, spd=2.572, length=25, beam=9
  contact = name=TARGET_CHARLIE, type=cargo, x=-4960.0, y=2538.6, hdg=218.7, spd=2.572, length=25, beam=9

  // Escort for the follow-by-AIS test (BHV_Trail / TRAIL_FOLLOW).
  //
  // Runs the SAME heading as the USV (38.7) instead of the reciprocal, so it
  // passes down the starboard side and then stays ahead on a parallel track -
  // something the boat can actually chase. Start is 250 m up the track and
  // 120 m to starboard of start_pos (x=-6289, y=400):
  //
  //            ESCORT * -->  hdg 38.7, 3.0 m/s (5.8 kn)
  //                    \  120 m to starboard, 250 m ahead
  //             [USV] --/    hdg 38.7
  //
  // 3.0 m/s is well under the USV's 15 m/s top speed, so the trail closes.
  // The mmsi is pinned (rather than auto-assigned from mmsi_base) so the UI
  // always has the same target to click: pTrafficSim names the NODE_REPORT
  // AIS366999777, which is exactly what
  //   TRAIL_FOLLOW=mmsi=366999777#range=100#angle=180
  // resolves to in iWebSocket.
  contact = name=ESCORT_DELTA, type=tug, mmsi=366999777, x=-6039.0, y=520.1, hdg=38.7, spd=3.0, length=25, beam=9

  // Same trio 1000 m out - closer start, wider relative bearings (+/-16.7 deg)
  //contact = name=TARGET_ALPHA,   type=cargo, x=-5663.8, y=1180.4, hdg=218.7, spd=2.572, length=25, beam=9
  //contact = name=TARGET_BRAVO,   type=cargo, x=-5429.6, y=992.9,  hdg=218.7, spd=2.572, length=25, beam=9
  //contact = name=TARGET_CHARLIE, type=cargo, x=-5897.9, y=1368.0, hdg=218.7, spd=2.572, length=25, beam=9

  // Previous setups - kept for reference, uncomment to restore
  // Two stationary targets abeam of each other, head-on test:
  //contact = name=TARGET_ALPHA, type=cargo, x=-5689, y=1400, hdg=218.7, spd=0, length=25, beam=9
  //contact = name=TARGET_BRAVO, type=cargo, x=-5489, y=1400, hdg=218.7, spd=0, length=25, beam=9
  // Single 5 kn tug just west of the USV:
  //contact = name=TUG_CHARLIE, type=tug, x=-6650, y=400, hdg=270, spd=2.572, length=25, beam=9
  // Original mixed traffic:
  //contact = name=TUG_ALPHA, type=tug, x=-6000, y=600, hdg=270, spd=4, length=25, beam=9
  //contact = name=FERRY_BRAVO, type=ferry, x=-6800, y=1000, hdg=90, spd=8, length=60, beam=14

  // (b) random traffic around the USV - off, this test needs exactly 3 contacts
  random_contacts = 0
  random_radius   = 1500
  random_spd_min  = 2
  random_spd_max  = 9

  // (c) closed-loop patrol - off for the same reason
  //loop = name=WORKBOAT_ECHO, type=cargo, spd=5, pts=-6000,200:-5600,200:-5600,800:-6000,800
}

// pColavEval Config Block
//
// Measures each avdcol_ encounter: how long the behaviour took to react, how
// close it actually got, which COLREGS mode it chose, how far it deflected.
// It needs the COLAV_BHV_* flags on the avdcol_ block in alpha.bhv - without
// those it sees nothing.

ProcessConfig = pColavEval
{
  AppTick   = 4
  CommsTick = 4

  // Verdict thresholds on the achieved closest range. Scaled to this boat and
  // to the behaviour's own envelope (min_util_cpa_dist 100, pwt_outer 300),
  // not to the shore-trial defaults uFldCollisionDetect ships with.
  collision_range = 20
  near_miss_range = 60

  // How far the range must open again before the panel calls the CPA passed.
  // The behaviour's own cpa_reached() is unlatched with a 5 cm threshold and
  // runs on an extrapolated position, so it trips while the boat is still
  // settling onto its leg; this is measured on real positions instead.
  cpa_confirm     = 15

  report_interval = 0.5
  max_records     = 6

  // Must match pTrafficSim's spawn_mmsi_base block, so a contact placed from
  // the UI is told apart from the scenario traffic by its MMSI alone.
  test_mmsi_low  = 366999900
  test_mmsi_high = 366999999
}

// uFldCollisionDetect Config Block
//
// An independent second opinion on the achieved CPA: pColavEval folds
// UCD_REPORT into its own record, so if the two ever disagree the panel shows
// it rather than hiding it. Ranges are scaled up from the stock 3/6/10 m,
// which are shore-trial numbers and meaningless for a 15 m/s USV.
//
// Not launched - see the note in the Antler block. It computes CPA between
// pairs of NODE_REPORTs and never sees ownship here, so it would run and
// report nothing. Kept configured so it is one line away if the ownship
// report is ever bridged in.

ProcessConfig = uFldCollisionDetect
{
  AppTick   = 4
  CommsTick = 4

  encounter_range = 400
  near_miss_range = 60
  collision_range = 20
  swing_range     = 5

  report_all_encounters = true
  pulse_render          = true
  pulse_range           = 60
  pulse_duration        = 10
}


//-------------------------------------------
// planchaPID bloco de config

ProcessConfig = planchaPID
{
   AppTick   = 20
   CommsTick = 20
   HEADING_KP = 0.9
   HEADING_KI = 0.0
   HEADING_KD = 0.2
   HEADING_UPPER_BOUND = 20
   HEADING_LOWER_BOUND = -20
}


//------------------------------------------------
// iWebSocket config block

ProcessConfig = iWebSocket
{
   AppTick   = 20
   CommsTick = 20

   // Collision avoidance envelope shown in the UI's Calibration tab. These
   // must mirror the avdcol_ block in alpha.bhv: until the operator edits
   // them the behaviour is running on its own configuration, and the panel is
   // only reporting it. Editing them in the panel pushes the new values into
   // every avdcol_ instance (and into pContactMgrV20's alert range) without
   // relaunching the mission - but does not write them back here, so a
   // relaunch returns to the .bhv values.
   colav_pwt_outer_dist    = 300
   colav_pwt_inner_dist    = 150
   colav_completed_dist    = 1500
   colav_min_util_cpa_dist = 100
   colav_max_util_cpa_dist = 300
}

//------------------------------------------------
// iNMEA config block

ProcessConfig = iNMEA
{
   AppTick   = 20
   CommsTick = 20
}

//------------------------------------------------
// iSignalK config block

ProcessConfig = iSignalK
{
   AppTick   = 4
   CommsTick = 4
}

//------------------------------------------
// pLogger config block

ProcessConfig = pLogger
{
  AppTick   = 8
  CommsTick = 8

  AsyncLog = true

  // For variables that are published in a bundle on their 
  // first post, explicitly declare their logging request
  Log = IVPHELM_LIFE_EVENT @ 0 NOSYNC
  Log = REPORT @ 0 NOSYNC
  Log = BHV_SETTINGS @ 0 NOSYNC
  Log = SUMMARY @ 0 NOSYNC

  LogAuxSrc = true
  // The collision avoidance result, and the same numbers in the stock spec so
  // alogcd and alogeplot can read a finished run.
  Log = COLAV_ENCOUNTER @ 0 NOSYNC
  Log = ENCOUNTER_SUMMARY @ 0 NOSYNC
  Log = COLLISION_DETECT_PARAMS @ 0 NOSYNC

  WildCardLogging = true
  WildCardOmitPattern = *_STATUS
  WildCardOmitPattern = DB_VARSUMMARY
  WildCardOmitPattern = DB_RWSUMMARY
  // The live feed and the 4 Hz behaviour trace are for the panel, not the log -
  // the per-encounter records above are what a run is analysed from.
  WildCardOmitPattern = COLAV_METRICS
  WildCardOmitPattern = COLAV_BHV_TRACE
  WildCardExclusionLog = true
}

//------------------------------------------
// uProcessWatch config block

ProcessConfig = uProcessWatch
{
  AppTick   = 4
  CommsTick = 4

  watch_all = true
	nowatch   = uPokeDB*
	nowatch   = uQueryDB*
	nowatch   = uXMS*
	nowatch   = uMAC*
}

//------------------------------------------
// uSimMarineV22 config block

ProcessConfig = uSimMarineV22
{
  AppTick  	= 4
  CommsTick	= 4

  start_pos     = x=-6289, y=400, heading=38.7, speed=0   // aimed straight at TARGET_BRAVO
  prefix        = NAV
  turn_rate     = 95
  thrust_map    = 0:0, 20:3, 40:6, 60:9, 80:12, 100:15
	turn_spd_loss = 0.4
}

//------------------------------------------
// pHelmIvP config block

ProcessConfig = pHelmIvP
{
  AppTick    = 4
  CommsTick  = 4

  behaviors  = alpha.bhv
  domain     = course:0:359:360
  domain     = speed:0:35:351

  ok_skew = any
  start_in_drive = true
  hold_on_apps = pContactMgrV20
  // The IVP_BEHAVIOR_DIRS env var already points at this same directory, and
  // loading it twice is a fatal "dangerously ambiguous" error in pHelmIvP.
  //ivp_behavior_dir = ../../lib

}

//------------------------------------------
// pMarinePID config block

ProcessConfig = pMarinePIDV22
{
  AppTick    = 20
  CommsTick  = 20

  verbose       = true
  depth_control = false

  // SIM_INSTABILITY = 20

  // Yaw PID controller
  yaw_pid_kp		 = 0.9
  yaw_pid_kd		 = 0.3
  yaw_pid_ki		 = 0.3
  yaw_pid_integral_limit = 0.07

  // Speed PID controller
  speed_pid_kp		 = 1.0
  speed_pid_kd		 = 0.0
  speed_pid_ki		 = 0.0
  speed_pid_integral_limit = 0.07

  //MAXIMUMS
  maxrudder    = 100
  maxthrust    = 100

  // A non-zero SPEED_FACTOR overrides use of SPEED_PID
  // Will set DESIRED_THRUST = DESIRED_SPEED * SPEED_FACTOR
  speed_factor = 1
}

//------------------------------------------
// pMarineViewer config block

ProcessConfig = pMarineViewer
{
  AppTick    = 4
  CommsTick  = 4

  tiff_file            = morgan_city.tif
	//tiff_file            = MIT_SP.tif

  set_pan_x            = -90
  set_pan_y            = -280
  zoom                 = 0.65
  vehicle_shape_scale  = 1.5
  hash_delta           = 50
  hash_shade           = 0.22
  hash_viewable        = false

  trails_point_size   = 1

	//op_vertex = x=-83, y=-47,    lwidth=1,lcolor=yellow,looped=true,group=moa
  //op_vertex = x=-46.4, y=-129.2, lwidth=1,lcolor=yellow,looped=true,group=moa
  //op_vertex = x=94.6, y=-62.2,   lwidth=1,lcolor=yellow,looped=true,group=moa
  //op_vertex = x=58,   y=20,    lwidth=1,lcolor=yellow,looped=true,group=moa

  // Appcast configuration
  appcast_height       = 75
  appcast_width        = 30
  appcast_viewable     = true
  appcast_color_scheme = indigo
  nodes_font_size      = xlarge
  procs_font_size      = xlarge
  appcast_font_size    = large
  
  // datum_viewable = true
  // datum_size     = 18
  // gui_size = small

  // left_context[survey-point] = DEPLOY=true
  // left_context[survey-point] = MOOS_MANUAL_OVERRIDE=false
  // left_context[survey-point] = RETURN=false

  right_context[return] = DEPLOY=true
  right_context[return] = MOOS_MANUAL_OVERRIDE=false
  right_context[return] = RETURN=false

  scope  = SUMMARY
  scope  = RETURN
  scope  = WPT_STAT
  scope  = VIEW_SEGLIST
  scope  = VIEW_POINT
  scope  = VIEW_POLYGON
  scope  = MVIEWER_LCLICK
  scope  = MVIEWER_RCLICK

  button_one = DEPLOY # DEPLOY=true
  button_one = MOOS_MANUAL_OVERRIDE=false # RETURN=false
  button_two = RETURN # RETURN=true
  button_three = REGION_TRUE # REGION=true
  button_four = REGION_FALSE # REGION=false

  action  = MENU_KEY=deploy # DEPLOY = true # RETURN = false
  action+ = MENU_KEY=deploy # MOOS_MANUAL_OVERRIDE=false
  action  = RETURN=true
  action  = UPDATES_RETURN=speed=1.4
}

//------------------------------------------
// pNodeReporter config block

ProcessConfig = pNodeReporter
{
  AppTick    = 2
  CommsTick	 = 2

  cross_fill_policy = global
  platform_type   = ship
  platform_color  = red
  platform_length = 70
}

//--------------------------------------------------------
// pContactMgrV20 Config Block

ProcessConfig = pContactMgrV20
{
  AppTick   = 2
  CommsTick = 2

  decay = 30,60

	app_logging = true
	
  alert_verbose = true

	contact_local_coords = force_lat_lon
	
  contact_max_age   = 300
  display_radii     = true
	display_radii_id  = avd
  alert_range_color = gray70
  cpa_range_color   = gray30

	alert = id=avdcol_, var=CONTACT_INFO, val="name=$[VNAME] # contact=$[VNAME]"
  // Must reach past the behavior's pwt_outer_dist/completed_dist in alpha.bhv
  // (300 / 1500), otherwise the contact drops out of the alert set while the
  // avdcol_ behavior still wants it. Was alert_range=1000, cpa_range=500.
  alert = id=avdcol_, alert_range=1500, cpa_range=1000
	
	//match_region = pts = {60,-40 : 60,-160 : 150,-160 : 180,-100 : 150,-40}
	//match_type = kayak, uuv

  disable_var = XYZ_DISABLE_TARGET
  enable_var  = XYZ_REENABLE_TARGET
  // pTrafficSim pokes this with a cleared target's name so the helm ends the
  // avoidance behaviour immediately, instead of leaving it running against a
  // contact that has simply stopped reporting. Needs can_disable=true on the
  // avdcol_ block in alpha.bhv - without it the expunge is a silent no-op.
  expunge_var = XYZ_EXPUNGE_TARGET
	
	post_closest_range   = true
  hold_alerts_for_helm = true
}

//------------------------------------------
// iMOOSGateway config block

ProcessConfig = iMOOSGateway
{
  AppTick  	= 4
  CommsTick	= 4

  tcp_port = 9501
	
	// comma separated moos variables to send to client                                                 
  forward_to_client = NAV_X, NAV_Y, NAV_HEADING
  
  // comma separated moos variables to block from client                                                
  block_from_client = DEPLOY
}

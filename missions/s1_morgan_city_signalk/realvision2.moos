ServerHost   = localhost
ServerPort   = 9000
Community    = alpha
MOOSTimeWarp = 1

//Morgan City
LatOrigin  = 29.71970895316288
LongOrigin = -91.14705165281887

//------------------------------------------
// Antler configuration  block
ProcessConfig = ANTLER
{
  MSBetweenLaunches = 200

  Run = MOOSDB        @ NewConsole = false
  Run = pLogger       @ NewConsole = false
  //Run = uSimMarineV22 @ NewConsole = false
  //Run = pMarinePIDV22 @ NewConsole = false
  Run = planchaPID @ NewConsole = false
  Run = iDivisorNMEA	@ NewConsole = true
  Run = pHelmIvP      @ NewConsole = false
  Run = pMarineViewer	@ NewConsole = false
  Run = uProcessWatch	@ NewConsole = false
  Run = pNodeReporter	@ NewConsole = false
  Run = pRealm	      @ NewConsole = false
  Run = iCAN	      @ NewConsole = false
  Run = iCANRec	      @ NewConsole = false
  //Run = iNMEA	      @ NewConsole = false
  //Run = iSignalK	      @ NewConsole = false
  Run = iWebSocket	      @ NewConsole = false
  Run = pXYpublisher      @ NewConsole = false
  Run = pContactSpawn	      @ NewConsole = false
  Run = pContactMgrV20 @ NewConsole = false
  Run = iRadarTargets @ NewConsole = false
 // Run = pVisionDetector_ref @ NewConsole = true
 // Run = pSensorFusionTracker_ref @ NewConsole = false
}


ProcessConfig = pSensorFusionTracker_ref
{
  AppTick   = 10
  CommsTick = 10
  
  //------------------------------------------------------------
  // Data Association Parameters
  //------------------------------------------------------------
  association_threshold = 15.0    // meters (Mahalanobis gate)
  track_timeout = 5.0             // seconds before track deleted
  quality_threshold = 0.5         // minimum quality to publish
  
  //------------------------------------------------------------
  // Measurement Noise (Standard Deviations)
  //------------------------------------------------------------
  // Radar noise (accurate range/velocity)
  radar_noise_pos = 3.0           // 3m position std dev
  radar_noise_vel = 0.5           // 0.5 m/s velocity std dev
  
  // Vision noise (less accurate position, no velocity)
  vision_noise_pos = 25.0         // 25m position std dev
  
  //------------------------------------------------------------
  // Process Noise (Motion Model Uncertainty)
  //------------------------------------------------------------
  process_noise_pos = 0.5         // 0.5 m/s^2 acceleration noise
  process_noise_vel = 0.2         // 0.2 m/s^2 velocity noise
  process_noise_yaw = 0.1         // 0.1 rad/s yaw rate noise
  
  //------------------------------------------------------------
  // Track Management
  //------------------------------------------------------------
  min_hits_to_confirm = 3         // confirmations needed
  max_misses = 5                  // misses before deletion
}

//--------------------------------------------------------------
// pVisionDetector - Camera-Based Detection
//--------------------------------------------------------------
ProcessConfig = pVisionDetector_ref
{
  AppTick   = 20
  CommsTick = 20
  
  rtsp_url = rtsp://douglas:Brazil2025!~@192.168.143.14:554/Streaming/Channels/101
  yolo_model_path = /home/douglas/Documents/yolo/yolo11n_openvino_model/yolo11n.xml
  
  confidence_threshold = 0.25
  nms_threshold = 0.45
  target_class = 8  // boat
  
  camera_height = 2.13
  average_boat_height = 2.5
  horizontal_fov = 87
  vertical_fov = 46
  distance_calibration_factor = 0.5
  
  exclusion_zone = 0.3,0.8,0.65,1.0
}


// iRadarTargets Config Block
ProcessConfig = iRadarTargets
{
  AppTick   = 10
  CommsTick = 10

  // UDP Configuration
  udp_port = 8091       // Port to receive NMEA $RATTM sentences
  udp_host = 127.0.0.1  // Host interface (localhost by default)
}

// pContactSpawn Config Block

ProcessConfig = pContactSpawn
{
  AppTick 	= 1
  CommsTick = 1 
}

//--------------------------------------------------------
// pContactMgrV20 Config Block

ProcessConfig = pContactMgrV20
{
  AppTick   = 2
  CommsTick = 2

  decay = 5,10
  app_logging = true
  alert_verbose = true
  contact_local_coords = force_lat_lon	
  contact_max_age   = 5
  display_radii     = true
  display_radii_id  = avd
  alert_range_color = gray70
  cpa_range_color   = gray30
  alert = id=avdcol_, var=CONTACT_INFO, val="name=$[VNAME] # contact=$[VNAME]"
  alert = id=avdcol_, alert_range=1000, cpa_range=500
	
  //match_region = pts = {60,-40 : 60,-160 : 150,-160 : 180,-100 : 150,-40}
	//match_type = kayak, uuv

  disable_var = XYZ_DISABLE_TARGET
  enable_var  = XYZ_REENABLE_TARGET
	
	post_closest_range   = true
  hold_alerts_for_helm = true
}



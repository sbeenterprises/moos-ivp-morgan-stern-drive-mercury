//--------    FILE: alpha.bhv   -------------

initialize   DEPLOY = false
initialize   RETURN = false
initialize   WAYPOINT = false
initialize   STATIONING = false
initialize   REGION = false
initialize   TRAILING = false
	
//----------------------------------------------
Behavior = BHV_Waypoint_mod
{ 
  name      = waypt_survey
  pwt       = 100
  condition = WAYPOINT = true
  endflag   = WAYPOINT = false
  //endflag   = MOOS_MANUAL_OVERRIDE = true
  endflag   = DESIRED_THRUST = 0 //zero thrust e rudder por segurança
  endflag   = DESIRED_RUDDER = 0

  updates    = WPT_UPDATE
  perpetual  = true

                lead = 400   // 400
         lead_damper = 0.6   //0.5
       lead_to_start = true
        capture_line = true
      capture_radius = 60    //65
         slip_radius = 90    //80
	efficiency_measure = all

    wpt_dist_to_prev = SURVEY_DIST_TO_PREV
    wpt_dist_to_next = SURVEY_DIST_TO_NEXT
	           
    visual_hints = nextpt_color=yellow
    visual_hints = nextpt_vertex_size=8
    visual_hints = nextpt_lcolor=gray70
    visual_hints = vertex_color=dodger_blue, edge_color=white
    visual_hints = vertex_size=5, edge_size=1
}

//----------------------------------------------
 Behavior = BHV_StationKeep
 {
   // General Behavior Parameters
   // ---------------------------
   name         = station-keep         // example
   pwt          = 50                   // put 150 to have a priority higher than BHV_Waypoint_mod
   condition = STATIONING = true
   endflag   = STATIONING = false
   updates   = STATION_UPDATES


   // Parameters specific to this behavior
   // ------------------------------------
      center_activate = false   // default
   hibernation_radius = -1     // default
         inner_radius = 15       
         outer_radius = 30      
         outer_speed  = 1    
       transit_speed  = 0.1    
       station_pt = 715,1742 
           swing_time = 0       // default

         visual_hints = vertex_size  = 1           // default
         visual_hints = edge_color   = light_blue  // default
         visual_hints = edge_size    = 1           // default
         visual_hints = label_color  = black      
         visual_hints = vertex_color = blue 
 }

 //----------------------------------------------
Behavior = BHV_AvdColregsV22
{
  name       = avdcol_
  pwt        = 250
  //condition  = DEPLOY = true 
  //Coloquei para fazer o desvio quando estiver rodando os waypoints
  condition = WAYPOINT = true
  updates    = CONTACT_INFO
  templating = spawn

                contact = $[VNAME]
       on_no_contact_ok = true
            extrapolate = true
                  decay = 30,60
	post_per_contact_info = false
	
          use_refinery = true
     // Engagement envelope. Was 50/30 outer/inner with a 30-50 m CPA band,
     // which only reacted inside ~50 m - late and abrupt on a boat that does
     // 15 m/s. Widened so the deflection starts far enough out to be visible
     // and to leave real standoff. Constraint: inner <= outer <= completed.
        pwt_outer_dist = 300
        pwt_inner_dist = 150
        completed_dist = 1500
     min_util_cpa_dist = 100
     max_util_cpa_dist = 300
             pwt_grade = linear
   bearing_line_config = white:0, green:0.65, yellow:0.8, red:1.0

   // Lets pContactMgrV20's expunge_var end this instance on demand. Without it
   // IvPContactBehavior::applyAbleFilter() returns immediately and the expunge
   // is a silent no-op, so clearing a test target from the UI would leave the
   // behaviour running against a contact that has stopped reporting.
   can_disable = true

   // Instrumentation for pColavEval. All one-shot except the trace at the
   // bottom, which repeats while an instance runs. Deliberately no $[CPA]
   // anywhere: it is accepted by postFlag() but never expanded, so it would
   // post a silent 0.0 - predicted CPA is computed in pColavEval instead.
   //
   // spawnxflag fires once on the instance's first iteration, after
   // updatePlatformInfo(), so the contact macros are already valid. (spawnflag
   // fires earlier, before that, and its geometry is garbage.)
   spawnxflag = COLAV_BHV_SPAWN=cn=$[CONTACT],utc=$[UTC],rng=$[RANGE],osx=$[OSX],osy=$[OSY],osh=$[OSH],osv=$[OSV],cnx=$[CNX],cny=$[CNY],cnh=$[CNH],cnv=$[CNV],oscn=$[OS_CN_REL_BNG],cnos=$[CN_OS_REL_BNG],roc=$[ROC]

   // Fires on each transition into ACTIVE - the moment the behaviour first
   // hands the helm an objective function, i.e. the real reaction instant.
   activeflag = COLAV_BHV_ACTIVE=cn=$[CONTACT],utc=$[UTC],rng=$[RANGE],mode=$[FULL_MODE],apwt=$[APWT],osh=$[OSH],roc=$[ROC],bngrate=$[BNG_RATE]

   // The behaviour already detects its own CPA turn-over (ContactStateSet::
   // cpa_reached), so the panel can show a provisional result there rather than
   // waiting out completed_dist*1.1 = 1650 m for the instance to die.
   cnflag = @cpa COLAV_BHV_CPA=cn=$[CONTACT],utc=$[UTC],rng=$[RANGE],mode=$[FULL_MODE],osh=$[OSH],oscn=$[OS_CN_REL_BNG],cnos=$[CN_OS_REL_BNG]

   // Closes the active span, so active duration is time actually influencing
   // the helm rather than wall-clock from first reaction to death.
   inactiveflag = COLAV_BHV_INACTIVE=cn=$[CONTACT],utc=$[UTC],rng=$[RANGE],mode=$[FULL_MODE]

   endflag = COLAV_BHV_END=cn=$[CONTACT],utc=$[UTC],rng=$[RANGE],mode=$[FULL_MODE],dur=$[DUR_RUN_TIME],osh=$[OSH]

   // One post per contact per helm iteration (4 Hz here) while an instance is
   // running. It used to be gated on COLAV_TEST, but the COLREGS box the UI
   // draws over the boat is fed from this: the mode is only re-reported on an
   // ACTIVE/INACTIVE/CPA transition otherwise, so a mode that changes while
   // the behaviour stays active - giveway stern to bow, or standon going
   // inextremis, which is the one the operator most needs to see - would never
   // reach the chart.
   runxflag = COLAV_BHV_TRACE=cn=$[CONTACT],utc=$[UTC],rng=$[RANGE],mode=$[FULL_MODE],apwt=$[APWT],osh=$[OSH],roc=$[ROC]
}

//----------------------------------------------
Behavior = BHV_OpRegionV24
 {
   name = opr24
   pwt  = 300
   condition = REGION = true
   endflag   = REGION = false
   updates   = REGION_UPDATES    

   core_poly = pts={-6790,253:-6777,7:-6604,48:-6592,247}
   save_dist = 5
   halt_dist = 100
   recover_spd = 5 // 5 knots of recovery speed
 }



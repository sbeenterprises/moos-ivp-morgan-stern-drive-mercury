
//-------------------------------------------------
// NAME: D. Lima
// FILE: external.moos
//
// The real.moos topology, but fed by an external simulator instead of the
// boat's own sensors and actuators.
//
//   ./bin/aissim tools/aissim/aissim.cfg
//
// aissim emits the USV's $GPRMC/$GPHDT/$AGRSA/$SDDPT and the surrounding
// traffic's !AIVDM to the Signal K server (UDP 10112). Signal K parses them
// for the UI and its udp-nmea-sender plugin re-emits every sentence to UDP
// 10111, where iDivisorNMEA turns them into NAV_* and NODE_REPORT. aissim
// reads DESIRED_RUDDER / DESIRED_THRUST back off iWebSocket's feed, which is
// what closes the control loop - it is standing in for iCAN and the hull.
//
// So: no uSimMarineV22, no iNMEA, no iCAN, and no pTrafficSim. Everything
// MOOS knows about the world arrives the same way it does on the water.
//
// Launch order matters: start this mission first so iWebSocket is listening,
// then start aissim.
//-------------------------------------------------

ServerHost   = localhost
ServerPort   = 9000
Community    = alpha
MOOSTimeWarp = 1

//Morgan City
LatOrigin  = 29.71970895316288
LongOrigin = -91.14705165281887

//------------------------------------------
// Antler configuration  block
ProcessConfig = ANTLER
{
  MSBetweenLaunches = 200

  Run = MOOSDB        @ NewConsole = false
  Run = pLogger       @ NewConsole = false

  // aissim owns the hull: it integrates rudder and thrust and reports the
  // result as NMEA0183. Running uSimMarineV22 as well would give the mission
  // two competing sources of NAV_*.
  //Run = uSimMarineV22 @ NewConsole = false
  //Run = pMarinePIDV22 @ NewConsole = false
  Run = planchaPID @ NewConsole = false

  // The whole point of this mission: NMEA0183 in from Signal K, NAV_* and AIS
  // NODE_REPORTs out.
  Run = iDivisorNMEA	@ NewConsole = false
  Run = pXYpublisher      @ NewConsole = false

  Run = pHelmIvP      @ NewConsole = false
  Run = pMarineViewer	@ NewConsole = false
  Run = uProcessWatch	@ NewConsole = false
  Run = pNodeReporter	@ NewConsole = false
  Run = pRealm	      @ NewConsole = false
  Run = iWebSocket	      @ NewConsole = false
  Run = pCorridor     @ NewConsole = false
  Run = pTurnLimit    @ NewConsole = false
  Run = pColavScale   @ NewConsole = false
  Run = pContactMgrV20 @ NewConsole = false

  // iCAN / iCANRec drive the real actuators - aissim reads the same demand off
  // iWebSocket instead, so there is no CAN bus in this mission.
  //Run = iCAN	      @ NewConsole = false
  //Run = iCANRec	      @ NewConsole = false

  // iNMEA would publish the USV's position back to Signal K, which aissim is
  // already doing - two talkers on one stream.
  //Run = iNMEA	      @ NewConsole = false
  //Run = iSignalK	      @ NewConsole = false

  // All traffic comes from aissim, over the AIS path. pTrafficSim and
  // pContactSpawn would inject a second, duplicate set of contacts.
  //Run = pContactSpawn	      @ NewConsole = false
  //Run = pTrafficSim   @ NewConsole = false

  Run = iRadarTargets @ NewConsole = false
}

// iRadarTargets Config Block

ProcessConfig = iRadarTargets
{
  AppTick   = 10
  CommsTick = 10

  // UDP Configuration
  udp_port = 8091       // Port to receive NMEA $RATTM sentences
  udp_host = 127.0.0.1  // Host interface (localhost by default)
}

// pContactSpawn Config Block

ProcessConfig = pContactSpawn
{
  AppTick 	= 1
  CommsTick = 1 
}

//--------------------------------------------------------
// pContactMgrV20 Config Block

ProcessConfig = pContactMgrV20
{
  AppTick   = 2
  CommsTick = 2

  decay = 5,10

	app_logging = true
	
  alert_verbose = true

	contact_local_coords = force_lat_lon
	
  contact_max_age   = 5
  display_radii     = true
	display_radii_id  = avd
  alert_range_color = gray70
  cpa_range_color   = gray30

	alert = id=avdcol_, var=CONTACT_INFO, val="name=$[VNAME] # contact=$[VNAME]"
  alert = id=avdcol_, alert_range=1000, cpa_range=500
	
	//match_region = pts = {60,-40 : 60,-160 : 150,-160 : 180,-100 : 150,-40}
	//match_type = kayak, uuv

  disable_var = XYZ_DISABLE_TARGET
  enable_var  = XYZ_REENABLE_TARGET
	
	post_closest_range   = true
  hold_alerts_for_helm = true
}


// iCANRec config block

ProcessConfig = iCANRec
{
   AppTick   = 20
   CommsTick = 20
}

// pXYpublisher config block

ProcessConfig = pXYpublisher
{
   AppTick   = 4
   CommsTick = 4
}
//------------------------------------------------


// iCAN config block

ProcessConfig = iCAN
{
   AppTick   = 50
   CommsTick = 50

   // The boat's CAN IDs, scaling, limits and lost-link values live in
   // this profile; nothing is hardcoded in iCAN. For USV-722 use
   //   profile_file = ../../profiles/usv722_glendinning.prf
   profile_file = ../../profiles/mercury_sterndrive.prf
}
//------------------------------------------------

//------------------------------------------------
// iDivisorNMEA config block

ProcessConfig = iDivisorNMEA
{
   AppTick   = 20
   CommsTick = 20

   // UDP port the Signal K udp-nmea-sender plugin forwards every received
   // NMEA0183 sentence to (~/.signalk/plugin-config-data/udp-nmea-sender.json).
   udp_port = 10111

   // Never turned into a contact. Must match ownship_mmsi in aissim.cfg, or
   // the USV sees its own transponder echo as traffic and avoids itself.
   ownship_mmsi = 710400014

   // This mission has no uSimMarineV22, so iDivisorNMEA is the only source of
   // NAV_*. Set false if you ever run it alongside a simulator that owns them.
   publish_nav = true

   report_interval    = 1     // seconds between NODE_REPORTs per contact
   default_length     = 60    // metres, when AIS carries no dimensions
   contact_stale_secs = 120   // forget a contact after this much silence
}
//------------------------------------------------


//-------------------------------------------
// planchaPID bloco de config

ProcessConfig = planchaPID
{
   AppTick   = 20
   CommsTick = 20
   HEADING_KP = 0.15
   HEADING_KI = 0.0
   HEADING_KD = 0.26
   HEADING_UPPER_BOUND = 20
   HEADING_LOWER_BOUND = -20
}


//------------------------------------------------
// iWebSocket config block

ProcessConfig = iWebSocket
{
   AppTick   = 20
   CommsTick = 20

   // No message or ping reply from SS UI for this long = link lost.
   // In manual control iCAN then sets rudder 0 and throttle 0.
   link_timeout = 3

   // Operating region: the polygon drawn in the UI is the HALT line; the
   // boat works inside it shrunk by this margin (BHV_OpRegionV26 breaches,
   // i.e. stops, on or just inside the drawn line).
   region_margin = 30
   // Halt this far before the drawn line, so the boat coasts to rest by it
   // (neutral, no braking). [P] set from the coasting distance at speed.
   region_halt_lead = 15
   // Speed to steer back into the working area (helm units: knots on the
   // boat, m/s in the sim); slow enough for a tight turn, enough to steer.
   region_recover_speed = 4
}

//------------------------------------------------
// pCorridor config block
//
// Route corridor monitor: cross-track error against the corridor the UI
// sends (CORRIDOR=...), zone in CORRIDOR_STATUS for the corridor_* behaviours
// in alpha.bhv. Thresholds, with half = width/2:
//   in <= slow_frac*half < slow <= half < recovering <= stop_factor*half < stop

ProcessConfig = pCorridor
{
  AppTick   = 4
  CommsTick = 4

  slow_frac    = 0.5   // "slow" beyond this share of the half width
  stop_factor  = 2.0   // "stop" beyond this many half widths
  hysteresis   = 2     // metres the xte must clear a boundary by to return
  recover_lead = 20    // metres ahead along the centreline to steer back to

  // While a corridor is on, waypt_survey follows the route tightly so it
  // neither skips short legs nor cuts corners; route_* restores alpha.bhv's
  // waypt_survey values when the corridor goes off (keep them in step).
  turn_slow_dist          = 60   // slow (CORRIDOR_TURN) this close to a sharp corner
  turn_min_angle          = 60   // degrees of heading change that count as sharp

  // aissim uses the uSimMarine hull model: same values as simulated.moos.
  slow_speed              = 3
  turn_speed              = 10
  recover_speed           = 3
  turn_allowance          = 30
  stop_action             = recover

  tighten_following       = true
  corridor_capture_radius = 15
  corridor_slip_radius    = 30
  corridor_lead           = 60
  route_capture_radius    = 60
  route_slip_radius       = 90
  route_lead              = 400
}

//------------------------------------------------
// iNMEA config block

ProcessConfig = iNMEA
{
   AppTick   = 4
   CommsTick = 4
}

//------------------------------------------------
// iSignalK config block

ProcessConfig = iSignalK
{
   AppTick   = 4
   CommsTick = 4
}

//------------------------------------------
// pLogger config block

ProcessConfig = pLogger
{
  AppTick   = 8
  CommsTick = 8

  AsyncLog = true

  // For variables that are published in a bundle on their 
  // first post, explicitly declare their logging request
  Log = IVPHELM_LIFE_EVENT @ 0 NOSYNC
  Log = REPORT @ 0 NOSYNC
  Log = BHV_SETTINGS @ 0 NOSYNC
  Log = SUMMARY @ 0 NOSYNC

  LogAuxSrc = true
  WildCardLogging = true
  WildCardOmitPattern = *_STATUS
  // ...but keep pCorridor's zone: the omit above would drop it.
  Log = CORRIDOR_STATUS @ 0 NOSYNC
  WildCardOmitPattern = DB_VARSUMMARY
  WildCardOmitPattern = DB_RWSUMMARY
  WildCardExclusionLog = true
}

//------------------------------------------
// uProcessWatch config block

ProcessConfig = uProcessWatch
{
  AppTick   = 4
  CommsTick = 4

  watch_all = true
	nowatch   = uPokeDB*
	nowatch   = uQueryDB*
	nowatch   = uXMS*
	nowatch   = uMAC*
}

//------------------------------------------
// uSimMarineV22 config block

ProcessConfig = uSimMarineV22
{
  AppTick  	= 4
  CommsTick	= 4

  start_pos     = x=0, y=0, heading=0, speed=0
  prefix        = NAV
  turn_rate     = 95
  thrust_map    = 0:0, 20:3, 40:6, 60:9, 80:12, 100:15
	turn_spd_loss = 0.4
}

//------------------------------------------
// pHelmIvP config block

ProcessConfig = pHelmIvP
{
  AppTick    = 4
  CommsTick  = 4

  behaviors  = alpha.bhv
  domain     = course:0:359:360
  domain     = speed:0:35:351

  ok_skew = any
  start_in_drive = false
  hold_on_apps = pContactMgrV20
  ivp_behavior_dir = ../../lib
}

//------------------------------------------
// pMarinePID config block

ProcessConfig = pMarinePIDV22
{
  AppTick    = 20
  CommsTick  = 20

  verbose       = true
  depth_control = false

  // SIM_INSTABILITY = 20

  // Yaw PID controller
  yaw_pid_kp		 = 0.9
  yaw_pid_kd		 = 0.3
  yaw_pid_ki		 = 0.3
  yaw_pid_integral_limit = 0.07

  // Speed PID controller
  speed_pid_kp		 = 1.0
  speed_pid_kd		 = 0.0
  speed_pid_ki		 = 0.0
  speed_pid_integral_limit = 0.07

  //MAXIMUMS
  maxrudder    = 100
  maxthrust    = 100

  // A non-zero SPEED_FACTOR overrides use of SPEED_PID
  // Will set DESIRED_THRUST = DESIRED_SPEED * SPEED_FACTOR
  speed_factor = 1
}

//------------------------------------------
// pMarineViewer config block

ProcessConfig = pMarineViewer
{
  AppTick    = 4
  CommsTick  = 4

  tiff_file            = morgan_city.tif
	//tiff_file            = MIT_SP.tif

  set_pan_x            = -90
  set_pan_y            = -280
  zoom                 = 0.65
  vehicle_shape_scale  = 1.5
  hash_delta           = 50
  hash_shade           = 0.22
  hash_viewable        = false

  trails_point_size   = 1

	//op_vertex = x=-83, y=-47,    lwidth=1,lcolor=yellow,looped=true,group=moa
  //op_vertex = x=-46.4, y=-129.2, lwidth=1,lcolor=yellow,looped=true,group=moa
  //op_vertex = x=94.6, y=-62.2,   lwidth=1,lcolor=yellow,looped=true,group=moa
  //op_vertex = x=58,   y=20,    lwidth=1,lcolor=yellow,looped=true,group=moa

  // Appcast configuration
  appcast_height       = 75
  appcast_width        = 30
  appcast_viewable     = true
  appcast_color_scheme = indigo
  nodes_font_size      = xlarge
  procs_font_size      = xlarge
  appcast_font_size    = large
  
  // datum_viewable = true
  // datum_size     = 18
  // gui_size = small

  // left_context[survey-point] = DEPLOY=true
  // left_context[survey-point] = MOOS_MANUAL_OVERRIDE=false
  // left_context[survey-point] = RETURN=false

  right_context[return] = DEPLOY=true
  right_context[return] = MOOS_MANUAL_OVERRIDE=false
  right_context[return] = RETURN=false

  scope  = SUMMARY
  scope  = RETURN
  scope  = WPT_STAT
  scope  = VIEW_SEGLIST
  scope  = VIEW_POINT
  scope  = VIEW_POLYGON
  scope  = MVIEWER_LCLICK
  scope  = MVIEWER_RCLICK

  button_one = DEPLOY # DEPLOY=true
  button_one = MOOS_MANUAL_OVERRIDE=false # RETURN=false
  button_two = RETURN # RETURN=true
  button_three = SLOWER # WPT_UPDATE=speed=1.5
  button_four = FASTER # WPT_UPDATE=speed=3.5

  action  = MENU_KEY=deploy # DEPLOY = true # RETURN = false
  action+ = MENU_KEY=deploy # MOOS_MANUAL_OVERRIDE=false
  action  = RETURN=true
  action  = UPDATES_RETURN=speed=1.4
  
  stale_report_thresh  = 5     // Exibe "Stale Report:" após 10s
  stale_remove_thresh  = 8 
  
}

//------------------------------------------
// pNodeReporter config block

ProcessConfig = pNodeReporter
{
  AppTick    = 2
  CommsTick	 = 2

  cross_fill_policy = global
  platform_type   = ship
  platform_color  = red
  platform_length = 70
}

//------------------------------------------------
// pTurnLimit config block
//
// Holds the boat to turn_speed near sharp route corners (with or without a
// corridor) and while it turns hard (desired heading far off its heading:
// region turn-away, collision avoidance, follow). At speed the rudder is
// limited, so turns are wide; this keeps them tight. Only slows the boat.

ProcessConfig = pTurnLimit
{
  AppTick   = 4
  CommsTick = 4

  turn_speed      = 5    // knots
  heading_trigger = 45   // deg off the desired heading -> limit
  heading_release = 15   // ... released below this
  corner_dist     = 100  // m to a route corner turning by corner_angle+
  corner_angle    = 60   // (route capture radius is 60 m without a corridor)
  hold_secs       = 3
}

//------------------------------------------------
// pColavScale config block
//
// Collision-avoidance distances from closing speed, per contact: start
// avoiding outer_secs before a possible meeting, full priority inner_secs
// before. The UI's Calibration distances (COLAV_DIST) are the minimums;
// outer_max is also pContactMgrV20's alert range. [P] until water-tested.

ProcessConfig = pColavScale
{
  AppTick   = 4
  CommsTick = 4

  nav_speed_units     = knots
  contact_speed_units = mps    // NODE_REPORT SPD (radar sends knots: earlier, never later)
  outer_secs = 60
  inner_secs = 30
  outer_min  = 150
  inner_min  = 75
  outer_max  = 1400
  inner_max  = 700
  cpa_range  = 1500    // keep >= avdcol_ completed_dist in alpha.bhv
}

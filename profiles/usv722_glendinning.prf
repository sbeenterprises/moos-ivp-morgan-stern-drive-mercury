//------------------------------------------------------------------
// Drive profile: USV-722
//   Yamaha F115B outboard (cable controlled, no engine data on CAN)
//   Glendinning helm at address 208 (0xD0), control processor at
//   226 (0xE2) driving the throttle and shift cables, steering
//   actuator reporting on 11-bit ID 0x210.
//
// Source: USV-722-CAN-ID-Mapping.xlsx and USV-722-CAN-Bus-Runbook.md
// (captures of 9 Oct 2026).
//
// Status marks:  [V] verified on usv-722   [P] placeholder
//
// The PC sends the helm's own messages, so it can only drive a
// signal while the helm is NOT sending it. guard=true makes iCAN
// listen first and refuse to transmit any ID the helm is still
// sending (posted as CAN_CONFLICT). Switch off the helm's steering
// before PC steering, as in the runbook's send test.
//
// Trim (18FF08D0) is enabled; see the notes there.
// Not included on purpose:
//   key (18FF0F10)  never send START from the PC (runbook)
//------------------------------------------------------------------

profile        = usv722_glendinning
can_interface  = slcan0                       // [V] 250 kbit/s, k800-can.service
capabilities   = steer, thrust, trim

rudder_limit_pct     = 100
thrust_limit_pct     = 100
thrust_deadband_pct  = 0
shift_neutral_secs   = 1.0                    // [P] processor also sequences shifts
shift_settle_secs    = 0.5                    // [P]

// Rudder vs speed, manual and autopilot alike (iCAN). The same rudder
// turns the hull harder as speed rises (16 Oct: 20 % gave 1.5 deg/s at
// 1.6 kn, 3.8 deg/s at 6.7 kn), and full lock while planing could roll
// the boat. speed (kn, NAV_SPEED):max rudder %. With no NAV_SPEED for
// speed_stale_secs the smallest value (8 %) applies.               [P]
rudder_limit_speed   = 0:100|5:100|10:40|18:12|27:8
speed_stale_secs     = 3
// Rudder slew: at most 50 % of travel per second (full swing about
// 4 s), so no sudden swing at speed.                               [P]
rudder_rate_pct_s    = 50

// Throttle ramp-up, manual and autopilot alike: the throttle sent rises
// by at most 10 % of lever per second (0 -> full lever in 10 s). Less
// throttle, stop, neutral and lost link act at once.               [P]
thrust_rate_up_pct_s = 10

// Lost link to SS UI while in manual: rudder 0, throttle 0 (neutral)
lost_link_rudder_pct = 0
lost_link_thrust_pct = 0

guard_secs = 1.0

// Alarm when the actual rudder differs from the command
rudder_feedback   = CAN_RUDDER_ACTUAL_PCT
rudder_alarm_pct  = 5                         // [P] 9 Oct test settled within 3%
rudder_alarm_secs = 3

//--- Steering command: 18FF11D0 (PGN 65297) -------------------- [V]
// Bytes 0-1 low byte first: 0 = full port, 511 = centre,
// 1012 = full starboard. Bytes 2-7 FF. Helm sends every 130 ms.
tx_msg   = name=steer, cap=steer, id=18FF11D0, dlc=8, period_ms=130, fill=FF, guard=true
tx_field = msg=steer, src=rudder_pct, byte=0, bits=16, order=le, map=points, points=-100:0|0:511|100:1012

//--- Gear lever: J1939 ETC2 18F005D0 --------------------------- [V]
// Byte 0: 7E forward, 7D neutral, 7C reverse.
tx_msg   = name=gear, cap=thrust, id=18F005D0, dlc=8, period_ms=130, fill=FF, guard=true
tx_field = msg=gear, src=gear, byte=0, bits=8, map=enum, values=fwd:7E|neutral:7D|rev:7C

//--- Throttle lever: J1939 EEC2 0CF003D0 ----------------------- [V]
// Byte 1 = engine throttle % / 0.4 (00 = 0 %, FA = 100 %), same in
// forward and reverse. Byte 0 FF. Helm sends about every 70 ms.
//
// Lever curve: DESIRED_THRUST % (UI lever / autopilot) -> engine %.
// Measured on 16 Oct 2026 (MOOSLog_16_10_2026_____10_19_49, 10_38_23),
// forward, steady state:
//   engine  0-30 %   1.3-1.7 kn  (idle in gear, no gain)
//   engine 31-36 %   3.5-4.3 kn
//   engine    40 %   4.8-5.1 kn
//   engine    45 %   6.4-8.2 kn
//   engine    50 %  24-27.6 kn  (planes; 42 % holds 17.7 kn once planing)
// The dead 0-30 % is squeezed into the first 10 % of the lever and
// lever 100 % = engine 50 %, the highest throttle wanted on this boat
// (about 27 kn). Points are lever%:byte, byte = engine % x 2.5.
//   lever   0  10  40   70  100
//   engine  0  30  40   45   50
tx_msg   = name=throttle, cap=thrust, id=0CF003D0, dlc=8, period_ms=70, fill=FF, guard=true
tx_field = msg=throttle, src=thrust_abs_pct, byte=1, bits=8, map=points, points=0:0|10:75|40:100|70:113|100:125

//--- Trim switch: 18FF08D0 (PGN 65288) -------------------------- [V]
// Byte 0: F1 = trim up held, F4 = trim down held, F0 = idle.
// The F0 idle frame is sent once when a pulse ends.
// Enabled. Open points from the runbook:
//  - Trim is momentary with no position feedback. Up runs on into full
//    tilt; down runs to the bottom stop (skeg touches ground), so the
//    down pulse is shorter.                                         [P]
//  - The helm sends 18FF08D0 all the time, so the guard blocks PC trim
//    while the helm is on. Nothing on the bus reacted to the trim switch
//    in the 9 Oct capture: confirm how the trim pump is switched.
//  - The high nibble of byte 0 is the helm-in-command flag (F = helm
//    steering, 0 = PC steering). F1/F4/F0 claim "helm steering"; check
//    with Glendinning whether 01/04/00 should be used while the PC steers.
trim_up_secs   = 1.0                          // [P]
trim_down_secs = 0.5                          // [P] shorter: skeg ground risk
tx_msg   = name=trim, cap=trim, id=18FF08D0, dlc=8, period_ms=130, fill=FF, guard=true
tx_field = msg=trim, src=trim, byte=0, bits=8, map=enum, values=up:F1|down:F4|idle:F0

//--- Autopilot (planchaPID) -----------------------------------------
// planchaPID reads these from this profile (see AutoTuning.h). Speeds
// are NAV_SPEED (knots); thrust is DESIRED_THRUST, i.e. lever % above.
//
// Speed feed-forward: lever % that holds a speed, from the table above.
// 8-24 kn has no steady state (the hull either ploughs or planes); the
// speed PID trims around it.                                       [P]
// 19 Oct 13:50 log: the old 7:70|24:100 gave 75 % for 10 kn and the boat
// planed up to 17 kn at that lever (75 % -> 17 kn and still climbing),
// while the speed PID (kp 0.16 %/kn, I-term 10 %) could only take ~11 %
// off. Steady points from the 16/19 Oct logs: 40 % -> 5.6 kn, 45 % ->
// 6.7 kn, 55 % -> 7.4 kn; 75 % ploughs at ~6.6 kn or planes at ~17 kn.
auto_speed_ff              = 0:0|1.5:9|4:25|5:40|7:55|10:65|17:75|24:100
// Feedback with the authority to pull thrust back from an overshoot:
// 2 %/kn above 6 kn (7 kn over -> -14 %) plus up to 20 % from the I-term.
auto_speed_gains           = 2:0.35:0.005|6:1.0:0.02|12:2.0:0.04|1000:2.0:0.04
auto_speed_i_authority_pct = 20                // [P] was 10: could not stop a planing overshoot
// Speed setpoint ramps (kn/s): thrust rises in step with what the speed
// loop can correct, and a big drop (operator, corridor slowing) is
// spread over a few seconds instead of one jump.                    [P]
auto_speed_ramp_up         = 0.5
auto_speed_ramp_down       = 1.5
auto_speed_filter          = 0.1
auto_heading_filter        = 0.15
auto_thrust_max_pct        = 100               // lever 100 % = engine 50 %
//
// Steering, from the same logs: + rudder turns to starboard. Turn rate
// at 20 % rudder: 1.5 deg/s at 1.6 kn, 3.8 deg/s at 6.7 kn.
// 16 Oct 11:27 autonomous run: with the old hardcoded gains (kp 0.22 at
// 6 kn, no I-term) a 20 deg error gave only 4.5 % rudder, about what
// the boat needs to cancel its slight port pull at that speed, so it
// held 20 deg to port of the course for 100+ s. Higher kp, plus an
// I-term (up to 10 % rudder) to trim out the pull.                 [P]
// Gains by NAV_SPEED (kn), up_to:kp:ki:kd; rudder % per deg error.
auto_heading_gains         = 5:0.6:0.03:0.10|10:0.5:0.03:0.10|15:0.35:0.02:0.08|20:0.25:0.015:0.06|1000:0.15:0.01:0.04
auto_heading_i_authority_pct = 10
auto_heading_limit_pct     = 40
auto_rudder_max_pct        = 40                // at or below 5 kn
auto_rudder_min_pct        = 10                // at or above 18 kn (planing)
auto_rudder_speed_low      = 5
auto_rudder_speed_high     = 18

//--- Feedback ------------------------------------------------------
// Steering actuator, 11-bit ID 210                                 [V]
rx_field = name=CAN_RUDDER_ACTUAL_PCT, id=210, ext=false, parts=B3:0-7|B6:2-3, map=points, points=0:-100|511:0|1012:100
rx_field = name=CAN_RUDDER_ECHO_PCT, id=210, ext=false, parts=B2:0-7|B6:0-1, map=points, points=0:-100|511:0|1012:100
rx_field = name=CAN_STEER_MOTOR_PCT, id=210, ext=false, parts=B4

// Helm in command of steering: high nibble of 18FF08D0 byte 0      [V]
rx_field = name=CAN_HELM_HAS_STEERING, id=18FF08D0, parts=B0:4-7, map=enum, values=F:true|0:false

// Helm lever and what the processor tells the engine               [V]
rx_field = name=CAN_HELM_GEAR, id=18F005D0, parts=B0, map=enum, values=7E:fwd|7D:neutral|7C:rev
rx_field = name=CAN_HELM_THROTTLE_PCT, id=0CF003D0, parts=B1, map=linear, scale=0.4
rx_field = name=CAN_ENGINE_GEAR, id=00F005E2, parts=B0, map=enum, values=7E:fwd|7D:neutral|7C:rev
rx_field = name=CAN_ENGINE_THROTTLE_PCT, id=00F003E2, parts=B1, map=linear, scale=0.4

// Fuel tank 0, NMEA 2000 PGN 127505                                [V]
rx_field = name=CAN_FUEL_PCT, id=19F21170, parts=B1:0-7|B2:0-7, map=linear, scale=0.004

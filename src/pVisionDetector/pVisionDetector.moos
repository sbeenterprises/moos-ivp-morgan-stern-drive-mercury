//--------------------------------------------------------
// pVisionDetector Configuration
//--------------------------------------------------------

ServerHost = localhost
ServerPort = 9000
Community  = alpha

ProcessConfig = pVisionDetector
{
  AppTick   = 20
  CommsTick = 20
  
  //============================================
  // Camera Settings
  //============================================
  rtsp_url = rtsp://douglas:Brazil2025!~@192.168.143.14:554/Streaming/Channels/101
  yolo_model_path = /home/douglas/Documents/yolo/yolo11n_openvino_model/yolo11n.xml
  
  //============================================
  // Camera Calibration
  //============================================
  camera_height = 2.13                    // meters above water
  average_boat_height = 2.5               // meters (for distance estimation)
  horizontal_fov = 87                     // degrees
  vertical_fov = 46                       // degrees
  distance_calibration_factor = 0.5       // tuning factor
  
  //============================================
  // Detection Parameters
  //============================================
  confidence_threshold = 0.25             // YOLO confidence threshold
  nms_threshold = 0.45                    // Non-max suppression
  target_class = 8                        // COCO class for boat
  
  //============================================
  // Exclusion Zone (normalized 0-1)
  //============================================
  // Format: x1,y1,x2,y2 (top-left to bottom-right)
  exclusion_zone = 0.3,0.8,0.65,1.0      // Center-bottom (own boat)
}

ProcessConfig = pLogger
{
  AppTick   = 10
  CommsTick = 10
  
  File      = VISION_DETECTOR_TEST
  PATH      = ./logs/
  
  Log = VISION_REPORT @ 0
  Log = NAV_X @ 0
  Log = NAV_Y @ 0
  Log = NAV_HEADING @ 0
}

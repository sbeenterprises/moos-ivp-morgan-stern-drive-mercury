#include "VisionDetector.h"
//#include "MBUtils.h"
#include <cmath>
#include <sstream>
#include <iomanip>
#include <sstream>
// Include YOLO inference
#include "YOLOInference.h"

using namespace std;

VisionDetector::VisionDetector()
{
    // Initialize own ship state
    m_own_x = 0.0;
    m_own_y = 0.0;
    m_own_heading = 0.0;
    
    // Initialize camera calibration (defaults)
    m_camera_height = 2.13;
    m_average_boat_height = 2.5;
    m_horizontal_fov = 87.0;
    m_vertical_fov = 46.0;
    m_distance_calibration_factor = 0.5;
    
    // Initialize detection parameters
    m_confidence_threshold = 0.25f;
    m_nms_threshold = 0.45f;
    m_target_class = 8;  // COCO class for boat
    
    // Initialize exclusion zone (default: center bottom)
    m_exclusion_x1 = 0.3;
    m_exclusion_y1 = 0.8;
    m_exclusion_x2 = 0.65;
    m_exclusion_y2 = 1.0;
    
    // Initialize statistics
    m_frame_count = 0;
    m_detection_count = 0;
    m_published_count = 0;
    m_last_fps_time = 0.0;
    m_current_fps = 0.0;
    
    // Thread control
    m_running = false;
    m_yolo = nullptr;
}

VisionDetector::~VisionDetector()
{
    // Stop vision thread
    m_running = false;
    if (m_vision_thread.joinable()) {
        m_vision_thread.join();
    }
    
    // Cleanup camera
    if (m_camera.isOpened()) {
        m_camera.release();
    }
    
    // Cleanup YOLO
    if (m_yolo != nullptr) {
        delete m_yolo;
    }
}

bool VisionDetector::OnNewMail(MOOSMSG_LIST &NewMail)
{
    AppCastingMOOSApp::OnNewMail(NewMail);

    MOOSMSG_LIST::iterator p;
    for(p=NewMail.begin(); p!=NewMail.end(); p++) {
        CMOOSMsg &msg = *p;
        string key = msg.GetKey();
        
        if(key == "NAV_X") {
            m_own_x = msg.GetDouble();
        }
        else if(key == "NAV_Y") {
            m_own_y = msg.GetDouble();
        }
        else if(key == "NAV_HEADING") {
            m_own_heading = msg.GetDouble();
        }
    }

    return true;
}

bool VisionDetector::Iterate()
{
    AppCastingMOOSApp::Iterate();
    
    // Process detections from queue
    std::lock_guard<std::mutex> lock(m_queue_mutex);
    
    while (!m_detection_queue.empty()) {
        VisionDetection det = m_detection_queue.front();
        m_detection_queue.pop();
        
        publishDetection(det);
    }
    
    AppCastingMOOSApp::PostReport();
    return true;
}

bool VisionDetector::OnConnectToServer()
{
    registerVariables();
    return true;
}

bool VisionDetector::OnStartUp()
{
    AppCastingMOOSApp::OnStartUp();

    std::cout << "DEBUG: OnStartUp() called" << std::endl;

    // Set defaults
    m_rtsp_url = "";
    m_yolo_model_path = "";

    STRING_LIST sParams;
    m_MissionReader.GetConfiguration(GetAppName(), sParams);
    
    std::cout << "DEBUG: Read " << sParams.size() << " config lines" << std::endl;

    STRING_LIST::iterator p;
    for(p=sParams.begin(); p!=sParams.end(); p++) {
        string line  = *p;
        
        // Simple key=value parsing
        size_t pos = line.find('=');
        if (pos == string::npos) continue;
        
        string param = line.substr(0, pos);
        string value = line.substr(pos + 1);
        
        // Trim whitespace
        param.erase(0, param.find_first_not_of(" \t"));
        param.erase(param.find_last_not_of(" \t") + 1);
        value.erase(0, value.find_first_not_of(" \t"));
        value.erase(value.find_last_not_of(" \t") + 1);
        
        // Convert param to lowercase
        for (size_t i = 0; i < param.length(); i++) {
            param[i] = tolower(param[i]);
        }
        
        std::cout << "DEBUG: Config - " << param << " = " << value << std::endl;

        // Camera settings
        if(param == "rtsp_url") {
            m_rtsp_url = value;
        }
        else if(param == "yolo_model_path") {
            m_yolo_model_path = value;
        }
        // ... rest of parameters ...
    }
    
    std::cout << "DEBUG: RTSP URL: " << m_rtsp_url << std::endl;
    std::cout << "DEBUG: Model path: " << m_yolo_model_path << std::endl;

    // Validate configuration
    if (m_rtsp_url.empty()) {
        std::cout << "ERROR: rtsp_url not specified" << std::endl;
        reportConfigWarning("rtsp_url not specified");
        return false;
    }
    
    if (m_yolo_model_path.empty()) {
        std::cout << "ERROR: yolo_model_path not specified" << std::endl;
        reportConfigWarning("yolo_model_path not specified");
        return false;
    }


    m_MissionReader.EnableVerbatimQuoting(false);
    if(!m_MissionReader.GetConfiguration(GetAppName(), sParams))
        reportConfigWarning("No config block found for " + GetAppName());

        string line  = *p;
        string param = MOOSToLower(MOOSChomp(line, "="));
        string value = line;

        bool handled = false;
        
        // Camera settings
        if(param == "rtsp_url") {
            m_rtsp_url = value;
            handled = true;
        }
        else if(param == "yolo_model_path") {
            m_yolo_model_path = value;
            handled = true;
        }
        // Calibration parameters
        else if(param == "camera_height") {
            m_camera_height = atof(value.c_str());
            handled = true;
        }
        else if(param == "average_boat_height") {
            m_average_boat_height = atof(value.c_str());
            handled = true;
        }
        else if(param == "horizontal_fov") {
            m_horizontal_fov = atof(value.c_str());
            handled = true;
        }
        else if(param == "vertical_fov") {
            m_vertical_fov = atof(value.c_str());
            handled = true;
        }
        else if(param == "distance_calibration_factor") {
            m_distance_calibration_factor = atof(value.c_str());
            handled = true;
        }
        // Detection parameters
        else if(param == "confidence_threshold") {
            m_confidence_threshold = atof(value.c_str());
            handled = true;
        }
        else if(param == "nms_threshold") {
            m_nms_threshold = atof(value.c_str());
            handled = true;
        }
        else if(param == "target_class") {
            m_target_class = atoi(value.c_str());
            handled = true;
        }
        // Exclusion zone
        else if(param == "exclusion_zone") {
 	   // Parse comma-separated values manually
   		 stringstream ss(value);
   		 string item;
   		 vector<double> values;
   		 while (getline(ss, item, ',')) {
       			 values.push_back(atof(item.c_str()));
   		 }
   		 if (values.size() == 4) {
       			 m_exclusion_x1 = values[0];
       			 m_exclusion_y1 = values[1];
       			 m_exclusion_x2 = values[2];
       			 m_exclusion_y2 = values[3];
   		 }
	}

        if(!handled)
            reportUnhandledConfigWarning(orig);
    }

    // Validate configuration
    if (m_rtsp_url.empty()) {
        reportConfigWarning("rtsp_url not specified");
        return false;
    }
    
    if (m_yolo_model_path.empty()) {
        reportConfigWarning("yolo_model_path not specified");
        return false;
    }
    
    // Initialize YOLO
    try {
        reportEvent("Loading YOLO model: " + m_yolo_model_path);
        m_yolo = new yolo::Inference(m_yolo_model_path, 
                                     cv::Size(640, 640),
                                     m_confidence_threshold,
                                     m_nms_threshold);
        reportEvent("✓ YOLO model loaded successfully");
    }
    catch (const exception& e) {
        reportRunWarning("Failed to load YOLO model: " + string(e.what()));
        return false;
    }
    
    // Open camera
    reportEvent("Connecting to camera: " + m_rtsp_url);
    m_camera.open(m_rtsp_url);
    m_camera.set(cv::CAP_PROP_BUFFERSIZE, 1);  // Reduce latency
    
    if (!m_camera.isOpened()) {
        reportRunWarning("Failed to open camera: " + m_rtsp_url);
        return false;
    }
    
    reportEvent("✓ Camera connected successfully");
    
    // Start vision thread
    m_running = true;
    m_vision_thread = std::thread(&VisionDetector::visionLoop, this);
    
    reportEvent("✓ Vision processing thread started");
    
    registerVariables();
    return true;
}

void VisionDetector::registerVariables()
{
    AppCastingMOOSApp::RegisterVariables();
    Register("NAV_X", 0);
    Register("NAV_Y", 0);
    Register("NAV_HEADING", 0);
}

void VisionDetector::visionLoop()
{
    reportEvent("Vision thread running");
    
    int frame_width = (int)m_camera.get(cv::CAP_PROP_FRAME_WIDTH);
    int frame_height = (int)m_camera.get(cv::CAP_PROP_FRAME_HEIGHT);
    
    reportEvent("Camera resolution: " + 
                to_string(frame_width) + "x" + to_string(frame_height));
    
    while (m_running) {
        cv::Mat frame;
        m_camera >> frame;
        
        if (frame.empty()) {
            reportRunWarning("Empty frame, reconnecting...");
            m_camera.release();
            std::this_thread::sleep_for(std::chrono::milliseconds(500));
            m_camera.open(m_rtsp_url);
            continue;
        }
        
        m_frame_count++;
        
        // Calculate FPS
        double current_time = MOOSTime();
        if (current_time - m_last_fps_time >= 1.0) {
            m_current_fps = m_frame_count / (current_time - m_last_fps_time);
            m_frame_count = 0;
            m_last_fps_time = current_time;
        }
        
        // Run YOLO inference (draws on frame)
        m_yolo->RunInference(frame);
        
        // Note: The Ultralytics implementation draws detections
        // but doesn't give us structured output. We need to adapt
        // the YOLOInference class to return detections.
        
        // For now, we'll need to modify the YOLO wrapper
        // This will be in YOLOInference.h/cpp
        
        std::this_thread::sleep_for(std::chrono::milliseconds(50)); // ~20 FPS
    }
    
    reportEvent("Vision thread stopped");
}

double VisionDetector::estimateDistance(int bbox_height_pixels, int image_height)
{
    if (bbox_height_pixels < 10) {
        return -1.0;  // Invalid
    }
    
    double vertical_fov_rad = m_vertical_fov * M_PI / 180.0;
    double focal_length_pixels = (image_height / 2.0) / tan(vertical_fov_rad / 2.0);
    double distance = (m_average_boat_height * focal_length_pixels) / bbox_height_pixels;
    distance *= m_distance_calibration_factor;
    
    return distance;
}

double VisionDetector::calculateBearing(int bbox_center_x, int image_width)
{
    double image_center_x = image_width / 2.0;
    double offset_x = bbox_center_x - image_center_x;
    double max_angle = m_horizontal_fov / 2.0;
    double normalized_offset = offset_x / (image_width / 2.0);
    double relative_bearing = normalized_offset * max_angle;
    
    // Convert to true bearing
    double true_bearing = m_own_heading + relative_bearing;
    
    // Normalize to 0-360
    while (true_bearing < 0) true_bearing += 360.0;
    while (true_bearing >= 360.0) true_bearing -= 360.0;
    
    return true_bearing;
}

bool VisionDetector::isInExclusionZone(int x1, int y1, int x2, int y2,
                                       int img_width, int img_height)
{
    int ex_x1 = (int)(m_exclusion_x1 * img_width);
    int ex_y1 = (int)(m_exclusion_y1 * img_height);
    int ex_x2 = (int)(m_exclusion_x2 * img_width);
    int ex_y2 = (int)(m_exclusion_y2 * img_height);
    
    int bbox_center_x = (x1 + x2) / 2;
    int bbox_center_y = (y1 + y2) / 2;
    
    return (bbox_center_x >= ex_x1 && bbox_center_x <= ex_x2 &&
            bbox_center_y >= ex_y1 && bbox_center_y <= ex_y2);
}

void VisionDetector::publishDetection(const VisionDetection& det)
{
    // Build VISION_REPORT string
    ostringstream oss;
    oss << fixed << setprecision(2);
    oss << "x=" << det.x << ",";
    oss << "y=" << det.y << ",";
    oss << "confidence=" << det.confidence << ",";
    oss << "bearing=" << det.bearing << ",";
    oss << "range=" << det.range << ",";
    oss << "class=" << det.classname << ",";
    oss << "timestamp=" << setprecision(3) << det.timestamp;
    
    Notify("VISION_REPORT", oss.str());
    m_published_count++;
}

bool VisionDetector::buildReport()
{
    m_msgs << "================================" << endl;
    m_msgs << "pVisionDetector Status" << endl;
    m_msgs << "================================" << endl;
    
    m_msgs << "Camera URL:    " << m_rtsp_url << endl;
    m_msgs << "Model Path:    " << m_yolo_model_path << endl;
    m_msgs << endl;
    
    m_msgs << "Own Ship State:" << endl;
    m_msgs << "  X:           " << m_own_x << " m" << endl;
    m_msgs << "  Y:           " << m_own_y << " m" << endl;
    m_msgs << "  Heading:     " << m_own_heading << " deg" << endl;
    m_msgs << endl;
    
    m_msgs << "Statistics:" << endl;
    m_msgs << "  FPS:         " << fixed << setprecision(1) << m_current_fps << endl;
    m_msgs << "  Detections:  " << m_detection_count << endl;
    m_msgs << "  Published:   " << m_published_count << endl;
    m_msgs << endl;
    
    m_msgs << "Detection Queue: " << m_detection_queue.size() << endl;
    
    return true;
}

// Main function
int main(int argc, char *argv[])
{
    VisionDetector app;
    app.Run(argv[0], argc, argv);
    return 0;
}
